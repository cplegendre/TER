  "roles": {
    "explore": {"provider": "anthropic", "model": "claude-sonnet-4-6"},
    "implement": {"provider": "anthropic", "model": "claude-sonnet-4-6"},
    "review": {"provider": "anthropic", "model": "claude-sonnet-4-6"},
    "escalate": {"provider": "anthropic", "model": "claude-opus-4-6"}
