{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ter:schema:ter.control-measures/1",
  "title": "ter.control-measures/1",
  "description": "A content-free measures file: one row per session, control measures only, no prompt, path or code (TER-SPC-009). Written by ter.domain.lean.control.MeasuresDocument.as_dict, read by MeasuresDocument.from_mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "detectors",
    "measures",
    "sessions"
  ],
  "properties": {
    "schema": {
      "const": "ter.control-measures/1"
    },
    "detectors": {
      "description": "The detector fingerprint every row was measured under. A file whose rows come from several detector sets lists every fingerprint (none when no session was measured); limits are only computed from one, so such a file is written but never charted.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "measures": {
      "description": "Each measure's label.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/measure_key"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "started_at",
          "values"
        ],
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "values": {
            "description": "Each measure's value; null when the session does not tell.",
            "type": "object",
            "propertyNames": {
              "$ref": "#/definitions/measure_key"
            },
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "measure_key": {
      "type": "string",
      "x-ter-enum": "ter.domain.lean.control:CONTROL_MEASURES#key",
      "enum": [
        "avoidable_share",
        "unverified_waste_share",
        "value_adding_share",
        "flow_efficiency_tokens",
        "flow_efficiency_time",
        "edits_validated_share",
        "ter",
        "confident_findings",
        "uncertain_findings",
        "rework_cycles",
        "risk_findings",
        "wip_peak",
        "unvalidated_edits_at_end",
        "unresolved_failures_at_end",
        "generated_tokens",
        "agent_seconds"
      ]
    }
  }
}
